# Copy to .env for local runs. Never commit the real key.
# Hugging Face Spaces: Settings → Secrets → GOOGLE_API_KEY
GOOGLE_API_KEY=

# Optional overrides. Defaults match current Gemini API models.
# The August 2025 report used gemini-2.0-flash and text-embedding-004.
# Both were retired, so the app uses these replacements.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
